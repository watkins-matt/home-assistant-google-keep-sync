{
    // Run and debug Home Assistant with this integration, or the tests, in the
    // dev container (see "Development" in README.md). Works with the folder or
    // with google-keep-sync.code-workspace open. The names and "presentation"
    // keep these together and ahead of core's own configs in the Run and
    // Debug list, which shows both when the workspace is open.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Google Keep Sync: Home Assistant",
            "presentation": { "group": "1-google-keep-sync", "order": 1 },
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "homeassistant",
            "cwd": "/workspaces/home-assistant-core",
            "args": ["--debug", "-c", "/workspaces/home-assistant-core/config"],
            // Home Assistant runs short-lived Python children (python -m uv,
            // python -m site); following them makes VS Code report
            // "Server[N] disconnected" each time one exits.
            "subProcess": false,
            "justMyCode": false
        },
        {
            "name": "Google Keep Sync: Home Assistant (skip pip)",
            "presentation": { "group": "1-google-keep-sync", "order": 2 },
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "homeassistant",
            "cwd": "/workspaces/home-assistant-core",
            "args": ["--debug", "-c", "/workspaces/home-assistant-core/config", "--skip-pip"],
            // Home Assistant runs short-lived Python children (python -m uv,
            // python -m site); following them makes VS Code report
            // "Server[N] disconnected" each time one exits.
            "subProcess": false,
            "justMyCode": false
        },
        {
            "name": "Google Keep Sync: Tests",
            "presentation": { "group": "1-google-keep-sync", "order": 3 },
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "pytest",
            "cwd": "/workspaces/home-assistant-google-keep-sync",
            "args": ["--no-cov", "tests"],
            "justMyCode": false
        }
    ]
}
