{
    // Run and debug Home Assistant with this integration, or the tests, in the
    // dev container (see "Development" in README.md). Works with the folder or
    // with google-keep-sync.code-workspace open.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "homeassistant",
            "cwd": "/workspaces/home-assistant-core",
            "args": ["--debug", "-c", "/workspaces/home-assistant-core/config"],
            "justMyCode": false
        },
        {
            "name": "Home Assistant (skip pip)",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "homeassistant",
            "cwd": "/workspaces/home-assistant-core",
            "args": ["--debug", "-c", "/workspaces/home-assistant-core/config", "--skip-pip"],
            "justMyCode": false
        },
        {
            "name": "Tests (Google Keep Sync)",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venvs/ha/bin/python",
            "module": "pytest",
            "cwd": "/workspaces/home-assistant-google-keep-sync",
            "args": ["--no-cov", "tests"],
            "justMyCode": false
        }
    ]
}
